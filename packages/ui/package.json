{
  "name": "@nexgen/ui",
  "version": "0.1.0",
  "private": true,
  "description": "neXgen Core component library — docs/frontend/DESIGN_SYSTEM.md §2's component inventory, built on Radix UI primitives + @nexgen/tokens, per ADR-0005/ADR-0009.",
  "type": "module",
  "sideEffects": ["*.css"],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "cross-env NODE_OPTIONS=--no-experimental-webstorage vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "@nexgen/tokens": "*",
    "@radix-ui/react-avatar": "^1.1.1",
    "@radix-ui/react-checkbox": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.2",
    "@radix-ui/react-radio-group": "^1.2.1",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-toast": "^1.2.2",
    "@radix-ui/react-tooltip": "^1.1.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.454.0",
