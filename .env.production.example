# neXgen Core — production operator configuration template
# Copy to .env.production (gitignored) and replace every REPLACE_* value.
# Never commit .env.production or real credentials.

# Public origins — no trailing slash.
BACKEND_PUBLIC_URL=https://api.example.com
GATEWAY_PUBLIC_URL=https://store-api.example.com
STOREFRONT_PUBLIC_URL=https://shop.example.com
ADMIN_PUBLIC_URL=https://admin.example.com
BACKEND_CORS_ALLOWED_ORIGINS=https://admin.example.com,https://shop.example.com

# Host ports used by docker-compose.production.yml. Your TLS reverse proxy can
# bind domains to these loopback/host ports.
BACKEND_PORT=8080
GATEWAY_PORT=4000
STOREFRONT_PORT=3000
ADMIN_PORT=8081

APP_NAME=neXgen Core
APP_KEY=REPLACE_WITH_LARAVEL_APP_KEY
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
LOG_LEVEL=info
BCRYPT_ROUNDS=12
API_RATE_LIMIT_PER_MINUTE=120
SANCTUM_TOKEN_EXPIRATION_MINUTES=20160

DB_DATABASE=nexgen
DB_USERNAME=nexgen
DB_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
DB_ROOT_PASSWORD=REPLACE_WITH_DIFFERENT_STRONG_ROOT_PASSWORD

REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD
# URL-encode the Redis password before placing it in this URL if it contains
# @, :, /, #, ? or other URL-reserved characters.
GATEWAY_REDIS_URL=redis://:REPLACE_WITH_URL_ENCODED_REDIS_PASSWORD@redis:6379
CACHE_PREFIX=nexgen_cache

# Generate these two Sanctum tokens after the database/roles are bootstrapped.
# See docs/deployment/PRODUCTION_DEPLOYMENT.md. Until then the compose file uses
# a non-secret bootstrap placeholder only when these keys are blank.
BACKEND_SERVICE_TOKEN=
BACKEND_CHECKOUT_SERVICE_TOKEN=

GUEST_SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
PREVIEW_TOKEN_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
PREVIEW_TOKEN_TTL_SECONDS=3600
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=en
DEFAULT_CURRENCY=BDT
GATEWAY_LOG_LEVEL=info
GATEWAY_RATE_LIMIT_MAX=120
GATEWAY_RATE_LIMIT_WINDOW_MS=60000

# Payment methods. A gateway with missing required credentials remains
# unavailable and is not presented by Checkout.
PAYMENTS_ENABLED_GATEWAYS=cod,bank_transfer,sslcommerz,bkash,nagad
PAYMENTS_COD_FEE=0.0000
PAYMENTS_CHECKOUT_RETURN_URL=https://shop.example.com/checkout/success

PAYMENTS_BANK_TRANSFER_BANK_NAME=
PAYMENTS_BANK_TRANSFER_ACCOUNT_NAME=
PAYMENTS_BANK_TRANSFER_ACCOUNT_NUMBER=
PAYMENTS_BANK_TRANSFER_ROUTING_NUMBER=
PAYMENTS_BANK_TRANSFER_BRANCH=

SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true

BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_SANDBOX=true

NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_PRIVATE_KEY=
NAGAD_PUBLIC_KEY=
NAGAD_SANDBOX=true

# Courier providers. Missing credentials make the corresponding automated
# courier unavailable; manual fulfillment remains possible.
SHIPPING_ENABLED_PROVIDERS=manual,steadfast,pathao,redx,paperfly,sundarban,ecourier
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
STEADFAST_BASE_URL=
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=
PATHAO_STORE_ID=
PATHAO_SANDBOX=true
REDX_API_TOKEN=
REDX_BASE_URL=
PAPERFLY_MERCHANT_ID=
PAPERFLY_API_KEY=
PAPERFLY_BASE_URL=
ECOURIER_API_KEY=
ECOURIER_API_SECRET=
ECOURIER_USER_ID=
ECOURIER_BASE_URL=

# Email/notification delivery. Keeping all real providers blank is allowed;
# the platform reports them unavailable instead of pretending delivery works.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME=neXgen Core
NOTIFICATIONS_ENABLED_EMAIL_PROVIDERS=smtp,mailgun,ses,brevo
NOTIFICATIONS_DEFAULT_EMAIL_PROVIDER=smtp
NOTIFICATIONS_SMTP_HOST=
NOTIFICATIONS_SMTP_PORT=587
NOTIFICATIONS_SMTP_ENCRYPTION=tls
NOTIFICATIONS_SMTP_USERNAME=
NOTIFICATIONS_SMTP_PASSWORD=
NOTIFICATIONS_SMTP_FROM_ADDRESS=
NOTIFICATIONS_SMTP_FROM_NAME=neXgen Core
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_REGION=us
MAILGUN_FROM_ADDRESS=
MAILGUN_FROM_NAME=neXgen Core
SES_REGION=us-east-1
SES_SMTP_USERNAME=
SES_SMTP_PASSWORD=
SES_SMTP_PORT=587
SES_FROM_ADDRESS=
SES_FROM_NAME=neXgen Core
BREVO_API_KEY=
BREVO_FROM_ADDRESS=
BREVO_FROM_NAME=neXgen Core

# Optional analytics/event destinations.
EVENTS_WEBHOOK_URL=
META_CAPI_ACCESS_TOKEN=
GA4_API_SECRET=
TIKTOK_EVENTS_ACCESS_TOKEN=

SEARCH_ENGINES=mysql_fulltext
SEARCH_DEFAULT_ENGINE=mysql_fulltext
SEARCH_REINDEX_CHUNK_SIZE=200
