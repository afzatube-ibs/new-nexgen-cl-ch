# The ONLY backend this app ever talks to — never the real backend directly
# (STORE_API_GATEWAY_ARCHITECTURE.md §1). Server-side only; never exposed
# to the browser (no NEXT_PUBLIC_ prefix).
STORE_API_GATEWAY_URL=http://127.0.0.1:4000

# Used for canonical URLs, sitemap.xml, robots.txt, and JSON-LD — safe to
# expose to the browser (NEXT_PUBLIC_ prefix), it is the site's own public URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The origin real Media assets are served from (PERFORMANCE_FOUNDATION.md
# §7) — configured, never hardcoded, so switching storage backends requires
# no frontend code change. Must match the hostname the backend's own Media
# URL generator actually emits (confirmed live: "localhost", not
# "127.0.0.1", even in a 127.0.0.1-reachable local dev setup) — next/image's
# remotePatterns allow-list matches by exact hostname string.
NEXT_PUBLIC_MEDIA_ORIGIN=http://localhost:8080

# Beta Sprint 3 — Cart Engine's own analytics hooks (`analytics/trackEvent.ts`).
# Deliberately DISTINCT from STORE_API_GATEWAY_URL above: this one IS meant
# for the browser (NEXT_PUBLIC_ prefix) — the Gateway's own `POST /v1/events`
# route is designed for direct browser calls (its own docblock: "the Browser
# → Gateway ingestion endpoint"), already has CORS configured for this
# origin (`apps/store-api-gateway`'s own CORS_ALLOWED_ORIGINS,
# `credentials: true` for the guest-session cookie), and never touches the
# Gateway's own backend service credential — that credential never leaves
# the Gateway process either way. Leaving this unset is a safe no-op
# (`trackEvent.ts` sends nothing), not an error.
NEXT_PUBLIC_STORE_API_GATEWAY_URL=http://localhost:4000
