APP_NAME="neXgen Core"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=cache

BCRYPT_ROUNDS=12

# Structured JSON logging so a correlation identifier reaches the actual log
# output, per ENGINEERING:LOGGING_PRINCIPLES / API:CORRELATION.
LOG_CHANNEL=structured
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ADR-0003: MySQL 8+ is the only primary datastore — never sqlite/mariadb.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nexgen
DB_USERNAME=nexgen
DB_PASSWORD=

# ARCH:NFR statelessness / ADR-0004: session, cache, and queue all live in
# Redis, externalized from the Application Unit — never file/database/sync,
# which would silently reintroduce per-instance state that blocks horizontal
# scaling of the Application Unit and Background Workers.
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_CONNECTION=default

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=nexgen_cache

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PAYMENTS_ENABLED_GATEWAYS=cod,bank_transfer,sslcommerz,bkash,nagad
PAYMENTS_COD_FEE=0.0000
PAYMENTS_RECONCILIATION_THRESHOLD_MINUTES=30

PAYMENTS_BANK_TRANSFER_BANK_NAME=
PAYMENTS_BANK_TRANSFER_ACCOUNT_NAME=
PAYMENTS_BANK_TRANSFER_ACCOUNT_NUMBER=
PAYMENTS_BANK_TRANSFER_ROUTING_NUMBER=
PAYMENTS_BANK_TRANSFER_BRANCH=

SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true

BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_SANDBOX=true

NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_PRIVATE_KEY=
NAGAD_PUBLIC_KEY=
NAGAD_SANDBOX=true

SHIPPING_ENABLED_PROVIDERS=manual,steadfast,pathao,redx,paperfly,sundarban,ecourier

STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=

PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=
PATHAO_STORE_ID=
PATHAO_SANDBOX=true

REDX_API_TOKEN=

PAPERFLY_MERCHANT_ID=
PAPERFLY_API_KEY=
PAPERFLY_BASE_URL=

ECOURIER_API_KEY=
ECOURIER_API_SECRET=
ECOURIER_USER_ID=
