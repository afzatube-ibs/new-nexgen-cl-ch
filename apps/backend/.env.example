APP_NAME="neXgen Core"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

# Production Completion Plan v2, Milestone 5b (Password Reset) — the real,
# public Storefront origin, used to build absolute links in backend-issued
# emails (e.g. a password reset link). Matches apps/storefront's own
# NEXT_PUBLIC_SITE_URL.
STOREFRONT_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=cache

BCRYPT_ROUNDS=12

# API:RATE_LIMITING's platform-wide floor (Phase 1.1 Production Hardening) —
# requests per minute per authenticated user (or per IP pre-authentication).
API_RATE_LIMIT_PER_MINUTE=120

# Comma-separated allowed browser origins (config/cors.php). `*` is safe only
# because this API never combines it with credentialed (cookie) auth — see
# that file's own docblock. Set to a real, named list before any
# browser-based client (Admin UI, storefront) goes to production.
CORS_ALLOWED_ORIGINS=*

# Structured JSON logging so a correlation identifier reaches the actual log
# output, per ENGINEERING:LOGGING_PRINCIPLES / API:CORRELATION.
LOG_CHANNEL=structured
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ADR-0003: MySQL 8+ is the only primary datastore — never sqlite/mariadb.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nexgen
DB_USERNAME=nexgen
DB_PASSWORD=

# ARCH:NFR statelessness / ADR-0004: session, cache, and queue all live in
# Redis, externalized from the Application Unit — never file/database/sync,
# which would silently reintroduce per-instance state that blocks horizontal
# scaling of the Application Unit and Background Workers.
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_CONNECTION=default

# API:AUTHENTICATION's bearer-token mechanism (Sanctum, never session
# cookies/SPA-stateful auth — this API never calls Sanctum's own
# `statefulApi()`, so SANCTUM_STATEFUL_DOMAINS is genuinely irrelevant
# here and deliberately not listed, to avoid implying a capability this
# API doesn't have). Token expiration IS a real production security
# parameter every issued token is subject to, not left to Sanctum's own
# 14-day package default without a conscious choice — documented here
# (Phase 1.1 Production Hardening environment-validation pass) rather
# than silently inherited.
SANCTUM_TOKEN_EXPIRATION_MINUTES=20160
SANCTUM_TOKEN_PREFIX=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=nexgen_cache

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PAYMENTS_ENABLED_GATEWAYS=cod,bank_transfer,sslcommerz,bkash,nagad
PAYMENTS_COD_FEE=0.0000
PAYMENTS_RECONCILIATION_THRESHOLD_MINUTES=30
# Where a gateway's hosted redirect flow (SSLCommerz/bKash/Nagad) sends the
# customer back to after payment. Defaults to APP_URL, which is correct
# only for this backend's own domain — a future storefront frontend MUST
# override this to its own domain before going live.
PAYMENTS_CHECKOUT_RETURN_URL=

PAYMENTS_BANK_TRANSFER_BANK_NAME=
PAYMENTS_BANK_TRANSFER_ACCOUNT_NAME=
PAYMENTS_BANK_TRANSFER_ACCOUNT_NUMBER=
PAYMENTS_BANK_TRANSFER_ROUTING_NUMBER=
PAYMENTS_BANK_TRANSFER_BRANCH=

SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true

BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_SANDBOX=true

NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_PRIVATE_KEY=
NAGAD_PUBLIC_KEY=
NAGAD_SANDBOX=true

SHIPPING_ENABLED_PROVIDERS=manual,steadfast,pathao,redx,paperfly,sundarban,ecourier

STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
# STEADFAST_BASE_URL=https://portal.packzy.com/api/v1

PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=
PATHAO_STORE_ID=
PATHAO_SANDBOX=true

REDX_API_TOKEN=
# REDX_BASE_URL=https://openapi.redx.com.bd/v1.0.0-beta

PAPERFLY_MERCHANT_ID=
PAPERFLY_API_KEY=
PAPERFLY_BASE_URL=

ECOURIER_API_KEY=
ECOURIER_API_SECRET=
ECOURIER_USER_ID=
# ECOURIER_BASE_URL=https://backend.ecourier.com.bd/api

# MODULE:NOTIFICATIONS' channel-provider configuration (Phase 1: email
# only — see config/notifications.php's own docblock for why SMS/
# WhatsApp are contract-ready but not wired). A provider whose credentials
# are left blank is simply unavailable (isAvailable() === false), never a
# silent half-configured failure.
NOTIFICATIONS_ENABLED_EMAIL_PROVIDERS=smtp,mailgun,ses,brevo
NOTIFICATIONS_DEFAULT_EMAIL_PROVIDER=smtp
NOTIFICATIONS_MAX_ATTEMPTS=5
NOTIFICATIONS_QUEUE_CONNECTION=redis
NOTIFICATIONS_QUEUE_NAME=notifications

NOTIFICATIONS_SMTP_HOST=
NOTIFICATIONS_SMTP_PORT=587
NOTIFICATIONS_SMTP_ENCRYPTION=tls
NOTIFICATIONS_SMTP_USERNAME=
NOTIFICATIONS_SMTP_PASSWORD=
NOTIFICATIONS_SMTP_FROM_ADDRESS=
NOTIFICATIONS_SMTP_FROM_NAME="${APP_NAME}"

MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_REGION=us
MAILGUN_FROM_ADDRESS=
MAILGUN_FROM_NAME="${APP_NAME}"

SES_REGION=us-east-1
SES_SMTP_USERNAME=
SES_SMTP_PASSWORD=
SES_SMTP_PORT=587
SES_FROM_ADDRESS=
SES_FROM_NAME="${APP_NAME}"

BREVO_API_KEY=
BREVO_FROM_ADDRESS=
BREVO_FROM_NAME="${APP_NAME}"

SEARCH_ENGINES=mysql_fulltext
SEARCH_DEFAULT_ENGINE=mysql_fulltext
SEARCH_REINDEX_CHUNK_SIZE=200
