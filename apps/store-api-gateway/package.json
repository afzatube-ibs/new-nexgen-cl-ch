{
  "name": "@nexgen/store-api-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Store API Gateway (BFF) — the ONLY public interface the future Storefront calls. Implements STORE_API_GATEWAY_ARCHITECTURE.md Slice 1. Never exposes internal Commerce APIs directly; orchestrates real Catalog/Search modules, owns no business logic of its own.",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src test --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^6.1.1",
    "fastify": "^5.12.1",
    "ioredis": "^5.4.2",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "undici": "^7.2.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nexgen/config": "*",
    "@types/node": "^22.10.5",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
