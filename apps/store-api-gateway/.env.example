# Store API Gateway — environment configuration
# See src/config/env.ts for validation and defaults.

# --- Server ---
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# --- Backend (real Commerce API, ADR-0007 REST) ---
BACKEND_BASE_URL=http://127.0.0.1:8080/api/v1
# Sanctum token for the scoped "Storefront Service" account (view-only
# catalog/search permissions) — see STORE_FRONTEND_ARCHITECTURE.md §3.2.
# Never a staff .manage token. Never sent to the browser.
BACKEND_SERVICE_TOKEN=

# --- Redis (cache abstraction; ADR-0004) ---
REDIS_URL=redis://127.0.0.1:6379
REDIS_KEY_PREFIX=nx_gw_cache:

# --- Guest session ---
GUEST_SESSION_COOKIE_NAME=nx_did
GUEST_SESSION_SECRET=change-me-in-every-environment-min-32-chars

# --- CORS (storefront origin(s), comma-separated) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Rate limiting ---
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

# --- Localization ---
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=en
DEFAULT_CURRENCY=USD

# --- Event Pipeline destinations (Slice 1.5) — all optional; unset means
# that destination is skipped (isAvailable() === false), never a boot error.
EVENTS_WEBHOOK_URL=
META_CAPI_ACCESS_TOKEN=
GA4_API_SECRET=
TIKTOK_EVENTS_ACCESS_TOKEN=

# --- Preview Framework (Slice 1.5) ---
PREVIEW_TOKEN_SECRET=change-me-in-every-environment-min-32-chars
PREVIEW_TOKEN_TTL_SECONDS=3600
PUBLIC_BASE_URL=http://127.0.0.1:4000
