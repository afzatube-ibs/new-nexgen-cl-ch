# apps/admin — copy to .env.local for local development (Vite convention;
# .env.local is gitignored). Never commit a real value here — see root
# .gitignore's existing `.env` / `!.env.example` rule.

# apps/backend's own API base URL + version prefix. Defaults (in code) to
# http://localhost:8080/api/v1, matching docker-compose.yml's default
# APP_PORT (8080) — override only if your backend runs elsewhere.
VITE_API_BASE_URL=http://localhost:8080/api/v1
