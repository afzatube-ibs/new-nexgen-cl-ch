# neXgen Core — root Docker Compose environment.
#
# Copy to `.env` before running `docker compose up`. Per SECURITY:SECURE_CONFIGURATION,
# no secret below ships with a working default — Compose refuses to start
# without these being set explicitly (see docker-compose.yml's `:?` guards).

APP_PORT=8080

DB_DATABASE=nexgen
DB_USERNAME=nexgen
DB_PASSWORD=
DB_ROOT_PASSWORD=

REDIS_PASSWORD=
